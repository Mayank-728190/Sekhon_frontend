# ============================================================
# AEROSCOUT — Environment Variables Template
# Copy this file to .env for local dev, or set these as
# environment variables in your deployment platform.
# ============================================================

# ── BACKEND API ────────────────────────────────────────────
# Base URL for REST API (FastAPI / Flask backend)
VITE_API_BASE_URL=http://localhost:8000

# Base URL for WebSocket connections
VITE_WS_BASE_URL=ws://localhost:8000

# Optional: Bearer token for authenticated endpoints
VITE_API_TOKEN=

# ── MAP TILES ──────────────────────────────────────────────
# Default: CartoDB Dark (no key required, free)
# Alternatives: MapBox, Google Maps, custom tiles
VITE_MAP_TILES_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Optional: MapBox access token (if using MapBox tiles)
VITE_MAPBOX_TOKEN=

# ── SIMULATION MODE ────────────────────────────────────────
# Set to "true" to use built-in simulation instead of real API
# Set to "false" in production to connect to real drone backend
VITE_USE_SIMULATION=true

# ── DEPLOYMENT ────────────────────────────────────────────
# Public URL where the app is served (for SEO meta tags)
VITE_APP_URL=http://localhost:5173

# App title (shown in browser tab)
VITE_APP_TITLE=AeroScout Command Center
